# Mobile environment template — copy to `.env` and adjust.
# Loaded at build/run time via: flutter run --dart-define-from-file=.env
#
# API_BASE_URL    REST API base, MUST include the /api/v1 prefix.
# SOCKET_BASE_URL Socket.IO host root, NO /api/v1 prefix.
#
# Local development (backend runs on port 7001):
#   Android emulator -> http://10.0.2.2:7001   (10.0.2.2 = host's localhost)
#   iOS sim / web    -> http://localhost:7001
# Production VPS:
#   https://backend.goracabs.com

API_BASE_URL=https://backend.goracabs.com/api/v1
SOCKET_BASE_URL=https://backend.goracabs.com
