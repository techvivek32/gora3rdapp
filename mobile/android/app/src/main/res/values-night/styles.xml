<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app UI is always light (MaterialApp themeMode: light), so we keep the
         native window background light even when the OS is in dark mode. Otherwise
         the window shows solid black whenever Flutter isn't drawing on it (launch,
         resume after the OS pauses the app, transitions) which looks like a
         "black screen" bug on devices with aggressive background-app killing. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
